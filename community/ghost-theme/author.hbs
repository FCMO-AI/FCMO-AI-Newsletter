{{!< default}}

{{#author}}
<header class="author-hero">
  <div class="container author-layout">
    {{#if profile_image}}<img class="avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}">{{/if}}
    <div>
      <p class="eyebrow">{{t "Author"}}</p>
      <h1>{{name}}</h1>
      {{#if bio}}<p class="dek">{{bio}}</p>{{/if}}
      <p class="meta-line">{{plural ../pagination.total empty=(t "No posts") singular=(t "% post") plural=(t "% posts")}}</p>
    </div>
  </div>
</header>
{{/author}}

<div class="container content-shell">
  <div class="post-grid">
    {{#foreach posts}}{{> "card"}}{{/foreach}}
  </div>
  {{pagination}}
</div>
