{{!< default}}

{{#post}}
<article class="container post-page {{post_class}}">
  <header class="post-header">
    <p class="eyebrow">{{t "FCMO Comunidad"}}</p>
    <h1>{{title}}</h1>
    {{#if custom_excerpt}}<p class="dek">{{custom_excerpt}}</p>{{/if}}
  </header>
  <div class="post-content">{{content}}</div>
</article>
{{/post}}
