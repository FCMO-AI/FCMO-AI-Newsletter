{{!< default}}

{{#post}}
<article class="container post-page {{post_class}}">
  <header class="post-header">
    <p class="eyebrow">{{primary_tag.name}}</p>
    <h1>{{title}}</h1>
    {{#if custom_excerpt}}<p class="dek">{{custom_excerpt}}</p>{{/if}}
    <div class="byline">
      <span>{{t "By"}} {{#foreach authors}}{{name}}{{#unless @last}}, {{/unless}}{{/foreach}}</span>
      <time datetime="{{date format="YYYY-MM-DDTHH:mm:ssZ"}}">{{date format="D MMM YYYY"}}</time>
    </div>
  </header>
  {{#if feature_image}}
    <figure class="post-image"><img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager"></figure>
  {{/if}}
  <div class="post-content">
    {{content}}
  </div>
  <footer class="post-footer">
    {{#foreach tags}}<a class="tag" href="{{url}}">#{{name}}</a>{{/foreach}}
  </footer>
  {{> "comments"}}
</article>
{{/post}}
