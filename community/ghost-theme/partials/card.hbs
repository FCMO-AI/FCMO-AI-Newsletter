<article class="post-card {{post_class}}">
  {{#if feature_image}}
    <a class="card-image" href="{{url}}" aria-label="{{title}}"><img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy"></a>
  {{/if}}
  <div class="card-body">
    {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
    <h3><a href="{{url}}">{{title}}</a></h3>
    {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{else}}<p>{{excerpt words="28"}}</p>{{/if}}
    <div class="card-meta"><time datetime="{{date format="YYYY-MM-DDTHH:mm:ssZ"}}">{{date format="D MMM YYYY"}}</time><span aria-hidden="true">·</span><span>{{reading_time}}</span></div>
  </div>
</article>
