<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="{{@site.url}}" aria-label="{{@site.title}}">
      <span class="brand-mark" aria-hidden="true">^</span>
      <span class="brand-name">{{@site.title}}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
      <span class="sr-only">{{t "Open menu"}}</span><span aria-hidden="true">Menu</span>
    </button>
    <nav id="site-navigation" class="site-navigation" aria-label="{{t "Primary navigation"}}">
      {{navigation}}
    </nav>
    <a class="header-cta" href="{{@site.url}}/#/portal/signup">{{t "Join"}}</a>
  </div>
</header>
