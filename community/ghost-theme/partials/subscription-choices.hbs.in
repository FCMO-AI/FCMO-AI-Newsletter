<section class="subscription-choices" aria-labelledby="subscription-choices-title">
  <div class="container">
    <p class="eyebrow">FCMO · fCMO × FCMO AI</p>
    <h2 id="subscription-choices-title">{{t "Two publications, one membership"}}</h2>
    <div class="subscription-choices-grid">
      <article><p class="eyebrow">fCMO · Javier</p><h3>Cartas de Javier</h3><p>{{t "Clear, warm letters that make ideas useful."}}</p></article>
      <article><p class="eyebrow">FCMO AI · Matías</p><h3>FCMO AI Newsletter</h3><p>{{t "A precise technical digest, grounded in evidence."}}</p></article>
    </div>
    <p>{{t "Choose either publication or both. Change your choices any time in your member account."}}</p>
    <p><a class="button" href="{{@site.url}}/#/portal/signup">{{t "Choose newsletters"}}</a></p>
  </div>
</section>
