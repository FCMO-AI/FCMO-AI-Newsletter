{{!< default}}

<section class="publication-intro">
  <div class="container intro-grid">
    <div>
      <p class="eyebrow">{{t "FCMO Comunidad"}}</p>
      <h1>{{@site.description}}</h1>
    </div>
    <p class="intro-note">{{t "Research, letters and practical conversation for people building with intelligence."}}</p>
  </div>
</section>

{{> "subscription-choices"}}

<div class="container content-shell">
  <div class="section-heading">
    <h2>{{t "Latest"}}</h2>
    <span class="section-rule" aria-hidden="true"></span>
  </div>
  <div class="post-grid">
    {{#foreach posts}}
      {{> "card"}}
    {{else}}
      <p class="empty-state">{{t "There are no posts yet."}}</p>
    {{/foreach}}
  </div>
  {{pagination}}
</div>
