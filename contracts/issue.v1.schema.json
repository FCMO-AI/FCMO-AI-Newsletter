{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fcmo-issue-v1",
  "x-contract": {"status": "v2-frozen"},
  "title": "FCMO curated issue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "date", "title", "note", "slots"],
  "properties": {
    "schema": {"const": "fcmo-issue-v1"},
    "id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]{3,80}$"},
    "date": {"type": "string", "format": "date"},
    "title": {"type": "object", "additionalProperties": false, "required": ["en", "es-419", "zh-Hans"], "properties": {"en": {"type": "string", "minLength": 1}, "es-419": {"type": "string", "minLength": 1}, "zh-Hans": {"type": "string", "minLength": 1}}},
    "note": {"type": "object", "additionalProperties": false, "required": ["en", "es-419", "zh-Hans"], "properties": {"en": {"type": "string"}, "es-419": {"type": "string"}, "zh-Hans": {"type": "string"}}},
    "slots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["slot", "ref"], "properties": {"slot": {"enum": ["principal", "essays", "day-in-ai", "notes"]}, "ref": {"type": "string", "pattern": "^(FCMO-P-[0-9a-f]{12}|FCMO-[0-9A-F]{12})$"}}}}
  }
}
