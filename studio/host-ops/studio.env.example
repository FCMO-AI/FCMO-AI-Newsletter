# Copy to an operator-selected private environment file, mode 0600.
# All host locations and tailnet names are supplied by the operator.
STUDIO_DATA=
STUDIO_BACKUPS=
STUDIO_REPO=
STUDIO_ORIGIN=
STUDIO_SESSION_KEY=
STUDIO_BIND=127.0.0.1
STUDIO_PORT=8490
# The architect enables live only after protected publishing and host acceptance.
STUDIO_LIVE_ENABLED=0
STUDIO_DRY_RUN=1
STUDIO_ALLOW_NON_EN_SOURCE=0
# gh stores each credential; two distinct GitHub identities are required.
# prepare_host.py fills the agreed private directories on this host.
STUDIO_GH_CONFIG_JAVIER=
STUDIO_GH_CONFIG_MATIAS=
# Optional named fine-grained tokens instead of gh; never substitute on refusal.
GH_TOKEN_JAVIER=
GH_TOKEN_MATIAS=

# Explicit author translation only; public builds never use this provider.
STUDIO_TRANSLATION_PROVIDER=claude-cli
STUDIO_TRANSLATION_TIMEOUT=120
