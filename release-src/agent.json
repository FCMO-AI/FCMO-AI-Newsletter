    "topics": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/topics.json",
    "organizations": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/organizations.json",
    "media": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/media.json",
    "llms": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/llms.txt",
    "llms_full": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/llms-full.txt",
    "developments_jsonl": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/developments.jsonl",
    "search_jsonl": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/search.jsonl",
