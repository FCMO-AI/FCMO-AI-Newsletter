    "feed_xml": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/feed.xml"
  },
  "query_types": {
    "manifest": {},
    "schema": {},
    "stats": {},
    "search": {
      "fields": [
        "q",
        "scope",
        "desk",
        "evidence",
        "confidence",
        "min_importance",
        "max_importance",
        "topic",
        "organization",
        "date_from",
        "date_to",
        "has_open_gaps",
        "sort",
        "fields",
        "limit"
      ],
      "offline_source": "data/search.json"
    },
    "resolve": {
      "fields": [
        "term"
      ],
      "offline_source": "data/developments.json + facets"
    },
    "brief": {
      "aliases": [
        "get"
      ],
      "fields": [
        "id"
      ],
      "endpoint": "data/briefs/<FCMO-ID>.json"
    },
    "sources": {
      "fields": [
        "id"
      ],
      "endpoint": "data/briefs/<FCMO-ID>.json + data/media.json"
    },
    "related": {
      "aliases": [
        "neighbors"
      ],
      "fields": [
        "id"
      ],
      "offline_source": "data/relationships.json"
    },
    "claims": {
      "fields": [
        "id",
        "label"
      ],
      "endpoint": "data/briefs/<FCMO-ID>.json"
    },
    "gaps": {
      "fields": [
        "q",
        "kind",
        "topic",
        "organization",
        "min_importance",
        "fields",
        "limit"
      ],
      "offline_source": "data/briefs/*.json"
    },
    "timeline": {
      "fields": [
        "date_from",
        "date_to",
        "desk",
        "min_importance",
        "fields",
        "limit"
      ],
      "offline_source": "data/developments.json"
    },
    "topics": {
      "offline_source": "data/topics.json"
    },
    "organizations": {
      "offline_source": "data/organizations.json"
    },
    "edition": {
      "fields": [
        "date"
      ],
      "endpoint": "data/editions/<YYYY-MM-DD>.json"
    },
    "documents": {
      "fields": [
        "q",
        "date",
        "limit"
      ],
      "offline_source": "data/search.json"
    }
  },
  "epistemic_contract": [
    "claim label",
    "evidence class",
    "confidence",
    "importance/consequence",
    "limitations",
    "contradictory evidence",
    "open evidence gaps"
  ],
  "examples": [
    {
      "type": "search",
      "evidence": "A",
      "min_importance": 6,
      "has_open_gaps": true,
