    "developments": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/developments.json",
    "brief": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/briefs/<FCMO-ID>.json",
    "relationships": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/relationships.json",
    "publication_memory": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/publication-memory.json",
    "edition": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/editions/<YYYY-MM-DD>.json",
    "topics": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/topics.json",
    "organizations": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/organizations.json",
    "media": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/media.json",
    "llms": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/llms.txt",
    "llms_full": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/llms-full.txt",
    "developments_jsonl": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/developments.jsonl",
    "search_jsonl": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/data/search.jsonl",
    "feed_json": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/feed.json",
    "feed_xml": "https://fcmo-ai.github.io/FCMO-AI-Newsletter/feed.xml"
  },
  "query_types": {
    "manifest": {},
    "schema": {},
    "stats": {},
    "search": {
      "fields": [
        "q",
        "scope",
        "desk",
        "evidence",
        "confidence",
        "min_importance",
        "max_importance",
        "topic",
        "organization",
        "date_from",
        "date_to",
        "has_open_gaps",
        "sort",
        "fields",
        "limit"
      ],
      "offline_source": "data/search.json"
    },
    "resolve": {
      "fields": [
        "term"
      ],
      "offline_source": "data/developments.json + facets"
    },
    "brief": {
      "aliases": [
        "get"
      ],
      "fields": [
        "id"
      ],
      "endpoint": "data/briefs/<FCMO-ID>.json"
    },
    "sources": {
      "fields": [
        "id"
      ],
      "endpoint": "data/briefs/<FCMO-ID>.json + data/media.json"
    },
    "related": {
      "aliases": [
        "neighbors"
      ],
      "fields": [
        "id"
      ],
      "offline_source": "data/relationships.json"
    },
    "claims": {
      "fields": [
        "id",
        "label"
      ],
      "endpoint": "data/briefs/<FCMO-ID>.json"
    },
    "gaps": {
      "fields": [
        "q",
        "kind",
        "topic",
        "organization",
        "min_importance",
        "fields",
        "limit"
      ],
      "offline_source": "data/briefs/*.json"
    },
    "timeline": {
      "fields": [
        "date_from",
        "date_to",
        "desk",
        "min_importance",
        "fields",
        "limit"
      ],
      "offline_source": "data/developments.json"
    },
    "topics": {
      "offline_source": "data/topics.json"
    },
    "organizations": {
      "offline_source": "data/organizations.json"
    },
    "edition": {
      "fields": [
        "date"
      ],
      "endpoint": "data/editions/<YYYY-MM-DD>.json"
    },
    "documents": {
      "fields": [
        "q",
        "date",
        "limit"
      ],
      "offline_source": "data/search.json"
    }
  },
  "epistemic_contract": [
    "claim label",
    "evidence class",
    "confidence",
    "importance/consequence",
    "limitations",
    "contradictory evidence",
    "open evidence gaps"
  ],
  "examples": [
    {
      "type": "search",
      "evidence": "A",
      "min_importance": 6,
      "has_open_gaps": true,
      "sort": "importance",
      "limit": 10
