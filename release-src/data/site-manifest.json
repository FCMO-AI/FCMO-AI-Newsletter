      },
      "gaps": {
        "fields": [
          "q",
          "kind",
          "topic",
          "organization",
          "min_importance",
          "fields",
          "limit"
        ],
        "offline_source": "data/briefs/*.json"
      },
      "timeline": {
        "fields": [
          "date_from",
          "date_to",
          "desk",
          "min_importance",
          "fields",
          "limit"
        ],
        "offline_source": "data/developments.json"
      },
      "topics": {
        "offline_source": "data/topics.json"
      },
      "organizations": {
        "offline_source": "data/organizations.json"
      },
      "edition": {
        "fields": [
          "date"
        ],
        "endpoint": "data/editions/<YYYY-MM-DD>.json"
      },
      "documents": {
        "fields": [
          "q",
          "date",
          "limit"
        ],
        "offline_source": "data/search.json"
      }
    },
    "epistemic_contract": [
      "claim label",
      "evidence class",
      "confidence",
      "importance/consequence",
      "limitations",
      "contradictory evidence",
      "open evidence gaps"
