# Template only. Actual credentials belong in /etc/fcmo/secrets/email.env (0600).
# Systemd EnvironmentFile syntax: single-quote values containing spaces.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
LISTMONK_URL=http://127.0.0.1:9000
LISTMONK_API_USER=fcmo-email
LISTMONK_API_KEY=REPLACE_WITH_LISTMONK_API_TOKEN
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=REPLACE_WITH_SES_SMTP_USERNAME
SES_SMTP_PASSWORD=REPLACE_WITH_SES_SMTP_PASSWORD
FCMO_EMAIL_SES_TOPIC_ARN=REPLACE_WITH_SES_FEEDBACK_SNS_TOPIC_ARN
FCMO_EMAIL_PUBLIC_URL=https://REPLACE_WITH_PUBLIC_EMAIL_HOST
FCMO_EMAIL_FROM='FCMO AI Diario <REPLACE_WITH_VERIFIED_SENDER>'
FCMO_EMAIL_POSTAL_ADDRESS='REPLACE_WITH_REAL_EDITORIAL_POSTAL_ADDRESS'
FCMO_EMAIL_PRIVACY_CONTACT='REPLACE_WITH_MONITORED_RIGHTS_CONTACT'
FCMO_EMAIL_DISPATCH_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
FCMO_EMAIL_CONSENT_KEY=REPLACE_WITH_SEPARATE_RANDOM_32_BYTE_KEY
FCMO_EMAIL_COMPLIANCE_READY=false
FCMO_EMAIL_RATE=2
FCMO_SITE_URL=https://fcmo-ai.github.io/FCMO-AI-Newsletter
# Encrypt backups to a recipient whose private key is stored separately.
FCMO_EMAIL_BACKUP_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
