{
  "schema_version": 2,
  "mission": {
    "objective": "Evaluate independent FCMO project proof surfaces through one shared dependency engine without collapsing them into one global health score or replacing project-local law.",
    "context": {
      "federation": "FCMO"
    }
  },
  "federation": {
    "receipt_requirements": {
      "newsletter": {
        "repository": "FCMO-AI/FCMO-AI-Newsletter",
        "scope": {
          "subject": "test-fixture"
        },
        "max_receipt_age_hours": 6
      },
      "cmpct": {
        "repository": "FCMO-AI/.CMPCT",
        "scope": {
          "subject": "test-fixture"
        },
        "max_receipt_age_hours": 6
      },
      "blm": {
        "repository": "Magyarmex/BLM",
        "scope": {
          "subject": "test-fixture"
        },
        "max_receipt_age_hours": 6
      }
    },
    "freshness_requirements": {
      "newsletter::public_material_sync": {
        "max_age_hours": 6
      },
      "cmpct::benchmark_semantics": {
        "max_age_hours": 6
      },
      "cmpct::archive_size_parity": {
        "max_age_hours": 6
      },
      "cmpct::timing_parity": {
        "max_age_hours": 6
      },
      "cmpct::portability": {
        "max_age_hours": 6
      },
      "blm::scientific_integrity": {
        "max_age_hours": 6
      },
      "blm::matched_control": {
        "max_age_hours": 6
      },
      "blm::scale_regime": {
        "max_age_hours": 6
      },
      "blm::q4_behavior": {
        "max_age_hours": 6
      }
    }
  },
  "claims": [
    {
      "id": "newsletter_material_sync_proven",
      "rule": {
        "all": [
          "newsletter::public_material_sync"
        ]
      }
    },
    {
      "id": "cmpct_release_parity_proven",
      "rule": {
        "all": [
          "cmpct::benchmark_semantics",
          "cmpct::archive_size_parity",
          "cmpct::timing_parity",
          "cmpct::portability"
        ]
      }
    },
    {
      "id": "blm_scientific_promotion_surface_proven",
      "rule": {
        "all": [
          "blm::scientific_integrity",
          "blm::matched_control",
          "blm::scale_regime",
          "blm::q4_behavior"
        ]
      }
    }
  ],
  "gates": [
    {
      "id": "represent_newsletter_materially_synced",
      "action": "Represent the Newsletter public corpus as materially synchronized with its project-owned upstream publication evidence",
      "behavior": "block_unless_valid",
      "rule": {
        "all": [
          "newsletter_material_sync_proven"
        ]
      }
    },
    {
      "id": "represent_cmpct_release_parity_proven",
      "action": "Represent a CMPCT core candidate as satisfying this fixture's release-parity proof surface; this is not release authority",
      "behavior": "block_unless_valid",
      "rule": {
        "all": [
          "cmpct_release_parity_proven"
        ]
      }
    },
    {
      "id": "represent_blm_scientific_promotion_proven",
      "action": "Represent a BLM experiment result as satisfying this fixture's scientific-promotion proof surface; this is not scientific promotion authority",
      "behavior": "block_unless_valid",
      "rule": {
        "all": [
          "blm_scientific_promotion_surface_proven"
        ]
      }
    }
  ]
}
